# ==========================================
# Backend API Environment Variables (server/.env)
# ==========================================
PORT=3000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/ai_resume_analyzer

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL (Allowed origin for CORS)
CLIENT_URL=http://localhost:5173

# Generative AI Tokens (Google Gemini & Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# Frontend Client Environment Variables (client/.env)
# ==========================================
VITE_API_URL=http://localhost:3000/api
